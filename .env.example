# ============================================
# CUANLY — Environment Variables
# Copy this file to .env and fill in your keys
# ============================================

# --- AI Engine 1: Google Gemini (Free Tier) ---
# Tugas: Parsing natural language → JSON transaksi
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- AI Engine 2: Groq (Free Tier) ---
# Tugas: Generate roasting Gen Z yang viral
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Bot Config ---
BOT_NAME=Cuanly
BOT_PREFIX=!
LOG_LEVEL=info
